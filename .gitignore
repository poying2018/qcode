# 依赖与构建产物
node_modules/
dist/

# 内置内核（约 92MB 的 node.exe + qwen-code 运行树，体积过大且需按平台/版本单独获取）
build/kernel/

# 运行时日志与探针残留
*.log
agent.log
_probe*
dev-data/

# 界面截图：smoke 顺带产出的原始图不入库（可能含本机路径与个人配置）。
# 对外展示图放在 docs/screenshots/，由 npm run shots 生成后人工确认。
shots/

# 本地环境
.env
.env.*
.DS_Store
Thumbs.db

# 编辑器
.vscode/
.idea/
*.swp
